# ============================================================
# SafeRoute V2 — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================================

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
PYTHON_ENV=development

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://saferoute:password@localhost:5432/saferoute_dev
# For Alembic (sync driver)
DATABASE_URL_SYNC=postgresql://saferoute:password@localhost:5432/saferoute_dev
# Test database
DATABASE_URL_TEST=postgresql+asyncpg://saferoute:password@localhost:5432/saferoute_test

# ── Mapbox ───────────────────────────────────────────────────
# Sign up at https://account.mapbox.com/ to get a token
# Free tier: 100,000 requests/month for Directions API
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
# Server-side secret token (for backend requests)
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret_token_here

# ── Clerk Authentication ─────────────────────────────────────
# Sign up at https://clerk.com/ and create an application
# Frontend (public, safe for browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
# Backend (secret, server-only)
CLERK_SECRET_KEY=sk_test_your_key_here
# Webhook signing secret (for Clerk -> backend user sync)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Frontend ─────────────────────────────────────────────────
# Public Mapbox token for the browser map component
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Backend ──────────────────────────────────────────────────
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Secret key for session/token signing (generate a random 32+ char string)
SECRET_KEY=change-me-to-a-random-secret-string
# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ── Deployment ───────────────────────────────────────────────
# These are set in the hosting provider, not locally
# VERCEL_URL=https://saferoute.vercel.app
# RENDER_EXTERNAL_URL=https://saferoute-api.onrender.com
